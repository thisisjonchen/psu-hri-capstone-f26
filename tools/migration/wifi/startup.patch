--- a/etc/dhcpcd.conf
+++ b/etc/dhcpcd.conf
@@ -57,3 +57,6 @@
 # fallback to static profile on eth0
 #interface eth0
 #fallback static_eth0
+
+interface wlan0
+nohook wpa_supplicant
--- a/etc/network/interfaces.d/wlan0
+++ b/etc/network/interfaces.d/wlan0
@@ -1,2 +1,2 @@
 allow-hotplug wlan0
-iface wlan0 inet dhcp
\ No newline at end of file
+iface wlan0 inet manual
\ No newline at end of file
--- a/data/autoboot/duckiedrone.yaml
+++ b/data/autoboot/duckiedrone.yaml
@@ -79,6 +79,7 @@
     environment:
       DT_SUPERUSER: 1
     volumes:
+      - /etc/pals-wifi-client-launcher.sh:/launch/dt-wifi-access-point/default.sh:ro
       - /data:/data
       # dtps sockets
       - /data/ramdisk/dtps:/dtps
--- a/etc/pals-wifi-client-launcher.sh
+++ b/etc/pals-wifi-client-launcher.sh
@@ -28,8 +28,5 @@
-    # remove IPs from device
-    ip addr flush dev ${INTERFACE}
-
-    # enable client mode
-    echo "[INFO] Enabling wifi client..."
-    dt-set-trigger wifi-client restart
+    # The host supplicant owns client Wi-Fi and its DHCP lease.
+    echo "[INFO] Ensuring wifi client is enabled..."
+    dt-set-trigger wifi-client on
     sleep 5
     echo "[INFO] Wifi client enabled."
--- /dev/null
+++ b/etc/systemd/system/wpa_supplicant.service.d/pals-client-config.conf
@@ -0,0 +1,5 @@
+[Unit]
+RequiresMountsFor=/config
+
+[Service]
+ExecStartPre=/bin/sh -c 'if [ -s /config/wpa_supplicant.conf ]; then install -m 0600 /config/wpa_supplicant.conf /etc/wpa_supplicant.conf; fi'
