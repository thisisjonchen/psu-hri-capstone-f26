+++ b/src/main/sensors/imu_integral.h
@@ -0,0 +1,15 @@
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+
+typedef struct {
+    uint32_t sequence, endUs, durationUs;
+    float rotation[4]; // x, y, z, w; end body axes relative to interval start.
+    float velocity[3]; // Integrated specific force in the starting body axes, m/s.
+    bool valid;
+} imuIntegral_t;
+
+void imuIntegralGyro(uint32_t now, const float rate[3], bool valid);
+void imuIntegralAccel(uint32_t now, const float force[3], bool valid);
+void imuIntegralRead(uint32_t now, imuIntegral_t *result);
+void imuIntegralReply(uint32_t now, uint32_t acknowledged, imuIntegral_t *result);
--- /dev/null
+++ b/src/main/sensors/imu_integral_impl.h
@@ -0,0 +1,122 @@
+// Included once in gyro.c. Sensor tasks and the MSP task run serially.
+#include <math.h>
+#include <string.h>
+#include "imu_integral.h"
+
+static struct {
+    uint32_t time, start, gyroTime, accelTime, sequence;
+    bool started, gyroValid, accelValid, valid;
+    float rate[3], force[3], q[4], velocity[3];
+} imuIntegral;
+
+static void integralProduct(const float a[4], const float b[4], float out[4])
+{
+    float r[4] = {
+        a[3]*b[0]+a[0]*b[3]+a[1]*b[2]-a[2]*b[1],
+        a[3]*b[1]-a[0]*b[2]+a[1]*b[3]+a[2]*b[0],
+        a[3]*b[2]+a[0]*b[1]-a[1]*b[0]+a[2]*b[3],
+        a[3]*b[3]-a[0]*b[0]-a[1]*b[1]-a[2]*b[2]
+    };
+    memcpy(out, r, sizeof(r));
+}
+
+static void integralAdvance(uint32_t now)
+{
+    if (!imuIntegral.started) {
+        imuIntegral.started = true;
+        imuIntegral.start = imuIntegral.time = now;
+        imuIntegral.q[3] = 1.f;
+        return;
+    }
+    const uint32_t elapsed = now - imuIntegral.time;
+    imuIntegral.time = now;
+    if (!elapsed) return;
+    if (!imuIntegral.gyroValid || !imuIntegral.accelValid || elapsed > 20000
+        || now - imuIntegral.gyroTime > 5000 || now - imuIntegral.accelTime > 10000
+        || now - imuIntegral.start > 200000) {
+        imuIntegral.valid = false;
+        return;
+    }
+    const float dt = elapsed * 1.e-6f;
+    // Compose every sample's rotation, preserving rotation about changing axes.
+    float half[4], mid[4];
+    float n = 1.f;
+    for (int i = 0; i < 3; i++) {
+        half[i] = imuIntegral.rate[i] * dt * .25f;
+        n += half[i]*half[i];
+    }
+    n = 1.f / sqrtf(n);
+    for (int i = 0; i < 3; i++) half[i] *= n;
+    half[3] = n;
+    integralProduct(imuIntegral.q, half, mid);
+    const float x=mid[0], y=mid[1], z=mid[2], w=mid[3];
+    const float *f = imuIntegral.force;
+    const float tx=2.f*(y*f[2]-z*f[1]), ty=2.f*(z*f[0]-x*f[2]), tz=2.f*(x*f[1]-y*f[0]);
+    imuIntegral.velocity[0] += (f[0]+w*tx+y*tz-z*ty)*dt;
+    imuIntegral.velocity[1] += (f[1]+w*ty+z*tx-x*tz)*dt;
+    imuIntegral.velocity[2] += (f[2]+w*tz+x*ty-y*tx)*dt;
+    integralProduct(mid, half, imuIntegral.q);
+}
+
+void imuIntegralGyro(uint32_t now, const float rate[3], bool valid)
+{
+    integralAdvance(now);
+    imuIntegral.gyroTime = now;
+    imuIntegral.gyroValid = valid;
+    if (!valid) imuIntegral.valid = false;
+    memcpy(imuIntegral.rate, rate, sizeof(imuIntegral.rate));
+}
+
+void imuIntegralAccel(uint32_t now, const float force[3], bool valid)
+{
+    integralAdvance(now);
+    imuIntegral.accelTime = now;
+    imuIntegral.accelValid = valid;
+    if (!valid) imuIntegral.valid = false;
+    memcpy(imuIntegral.force, force, sizeof(imuIntegral.force));
+}
+
+void imuIntegralRead(uint32_t now, imuIntegral_t *result)
+{
+    integralAdvance(now);
+    result->sequence = ++imuIntegral.sequence;
+    result->endUs = now;
+    result->durationUs = now - imuIntegral.start;
+    result->valid = imuIntegral.valid && result->durationUs > 0 && result->durationUs <= 200000;
+    float norm = 0.f;
+    for (int i = 0; i < 4; i++) norm += imuIntegral.q[i]*imuIntegral.q[i];
+    norm = 1.f / sqrtf(norm);
+    for (int i = 0; i < 4; i++) result->rotation[i] = imuIntegral.q[i]*norm;
+    memcpy(result->velocity, imuIntegral.velocity, sizeof(result->velocity));
+    memset(imuIntegral.velocity, 0, sizeof(imuIntegral.velocity));
+    memset(imuIntegral.q, 0, sizeof(imuIntegral.q));
+    imuIntegral.q[3] = 1.f;
+    imuIntegral.start = now;
+    imuIntegral.valid = imuIntegral.gyroValid && imuIntegral.accelValid;
+}
+
+static imuIntegral_t pendingIntegral;
+static uint32_t acknowledgedIntegral;
+
+void imuIntegralReply(uint32_t now, uint32_t acknowledged, imuIntegral_t *result)
+{
+    imuIntegralRead(now, result);
+    if (acknowledged == 0 || acknowledged == pendingIntegral.sequence) {
+        acknowledgedIntegral = acknowledged;
+    } else if (pendingIntegral.sequence) {
+        // Retain an unanswered interval, including its changing body frame.
+        const float *q=pendingIntegral.rotation, *v=result->velocity;
+        const float tx=2.f*(q[1]*v[2]-q[2]*v[1]);
+        const float ty=2.f*(q[2]*v[0]-q[0]*v[2]);
+        const float tz=2.f*(q[0]*v[1]-q[1]*v[0]);
+        float sum[3] = {v[0]+q[3]*tx+q[1]*tz-q[2]*ty,
+                        v[1]+q[3]*ty+q[2]*tx-q[0]*tz,
+                        v[2]+q[3]*tz+q[0]*ty-q[1]*tx};
+        for (int i=0;i<3;i++) result->velocity[i]=pendingIntegral.velocity[i]+sum[i];
+        integralProduct(q,result->rotation,result->rotation);
+        result->durationUs += pendingIntegral.durationUs;
+        result->valid = result->valid && pendingIntegral.valid && acknowledged == acknowledgedIntegral
+            && result->durationUs <= 200000;
+    }
+    pendingIntegral = *result;
+}
