# Keep executable scripts usable on the drones after a Windows checkout.
*.py text eol=lf
*.sh text eol=lf
*.screenrc text eol=lf
src/scripts/PALS/*_node text eol=lf
src/scripts/PALS/apriltag_detection_drone text eol=lf
# Unified diff context prefixes are not source indentation or trailing whitespace.
*.patch whitespace=-blank-at-eol,-space-before-tab
