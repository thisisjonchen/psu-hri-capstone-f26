#!/usr/bin/env python
"""Publish EKF controller state and align local odometry with the room map.

UWB corrects only the room offset; tag 5 corrects room heading. Neither changes
EKF position or velocity. ToF freshness remains part of controller readiness.
"""
import math
import threading
from copy import deepcopy
from collections import deque

import numpy as np
import rospy
import tf
from diagnostic_msgs.msg import DiagnosticArray, DiagnosticStatus, KeyValue
from geometry_msgs.msg import PoseWithCovarianceStamped
from nav_msgs.msg import Odometry
from pidrone_pkg.msg import AnchorLayout, Mode, State, TagCorners
from sensor_msgs.msg import CameraInfo, Range
from std_msgs.msg import Bool, UInt32

from localization.fusion import RoomOffset
from localization.position import PositionCombiner
from localization.apriltag_geometry import camera_rotation, floor_tag_yaw_offset
from localization import monotonic
from localization.rotations import quaternion_matrix


class FusionLocalizationNode(object):
    def __init__(self):
        self.lock = threading.RLock()
        self.ekf_odom = None
        self.ekf_history = deque()
        self.ekf_ready, self.ekf_ready_at = False, None
        self.ekf_reference_lost = False
        self.ekf_published_stamp = None
        self.range_stamp = None
        self.timeout = float(rospy.get_param('~sensor_timeout', 0.5))
        self.room = RoomOffset(
            drift_stddev=float(rospy.get_param('~drift_stddev', 0.08)),
            gate=float(rospy.get_param('~innovation_gate', 9.21)),
            max_innovation=float(rospy.get_param('~max_innovation', 1.0)))
        self.skew = float(rospy.get_param('~max_sensor_skew', 0.15))
        self.frame = rospy.get_param('~frame_id', 'map')
        self.odom_frame = 'ekf_odom'
        self.body_frame = rospy.get_param('~body_frame', 'pidrone_body')
        if (len(set((self.frame, self.odom_frame, self.body_frame))) != 3
                or not all((self.frame, self.odom_frame, self.body_frame))
                or not all(np.isfinite(v) and v > 0 for v in (self.timeout, self.skew))):
            raise ValueError('Invalid fusion frames or timeouts')
        self.height = PositionCombiner(
            stale_after=self.timeout, max_skew=self.skew,
            floor_z=float(rospy.get_param('~floor_z', 0.0)),
            tof_offset_z=float(rospy.get_param('~tof_offset_z', 0.0)))
        self.attitude = None
        self.attitude_history = deque(maxlen=200)
        self.tag_camera = None
        self.tag_rotation = camera_rotation(
            float(rospy.get_param('~tag_camera/camera_pitch_down_deg', 45.0)),
            float(rospy.get_param('~tag_camera/camera_azimuth_deg', 0.0)),
            float(rospy.get_param('~tag_camera/camera_image_roll_deg', 0.0)))
        self.tag_samples = deque(maxlen=3)
        self.tag_last_stamp = None
        self.tag_correction_at = None
        self.tag_accepted_stamp = None
        self.tag_reason = 'Waiting for tag 5'
        self.mode = None
        self.mode_at = None
        self.pending = []
        self.layout = None
        self.layout_stamp = None
        self.generation = 0
        self.last_time = None
        self.reason = 'Waiting for UWB'
        self.local_reason = 'Waiting for EKF readiness'
        self.state_pub = rospy.Publisher('pidrone/state', State, queue_size=1, tcp_nodelay=True)
        self.pose_pub = rospy.Publisher('pidrone/localization/fused', PoseWithCovarianceStamped, queue_size=1)
        self.odom_pub = rospy.Publisher('pidrone/localization/odometry', Odometry, queue_size=1)
        self.status_pub = rospy.Publisher('pidrone/localization/fusion_status', DiagnosticArray, queue_size=1)
        self.local_pub = rospy.Publisher('pidrone/localization/local_ready', Bool, queue_size=1)
        self.ready_pub = rospy.Publisher('pidrone/localization/ready', Bool, queue_size=1)
        self.generation_pub = rospy.Publisher('pidrone/localization/generation', UInt32, queue_size=1)
        self.broadcaster = tf.TransformBroadcaster()
        self.subscribers = [
            rospy.Subscriber('pidrone/mode', Mode, self.mode_callback, queue_size=1),
            rospy.Subscriber('pidrone/apriltag/reference_corners', TagCorners, self.tag_callback, queue_size=1),
            rospy.Subscriber('raspicam_node/camera_info', CameraInfo, self.camera_callback, queue_size=1),
            rospy.Subscriber('pidrone/range', Range, self.range_callback, queue_size=1),
            rospy.Subscriber('pidrone/localization/uwb', PoseWithCovarianceStamped, self.uwb_callback, queue_size=10),
            rospy.Subscriber('pidrone/localization/anchors', AnchorLayout, self.anchors_callback, queue_size=1),
            rospy.Subscriber('pidrone/ekf/odometry', Odometry, self.ekf_callback, queue_size=1,
                             tcp_nodelay=True),
            rospy.Subscriber('pidrone/ekf/local_ready', Bool, self.ekf_ready_callback, queue_size=1)]
        rospy.loginfo('Waiting to align heading: keep drone disarmed, stationary and facing map +Y')

    def fresh(self, stamp, now, timeout=None):
        limit = self.timeout if timeout is None else timeout
        return stamp is not None and 0 < stamp <= now and now - stamp <= limit

    def invalidate_room(self):
        self.room.reset()
        self.pending = []
        self.generation += 1

    def mode_callback(self, msg):
        with self.lock:
            self.mode, self.mode_at = msg.mode, rospy.get_time()

    def ekf_ready_callback(self, msg):
        with self.lock:
            self.ekf_ready, self.ekf_ready_at = bool(msg.data), rospy.get_time()

    def ekf_callback(self, msg):
        with self.lock:
            now, stamp = rospy.get_time(), msg.header.stamp.to_sec()
            if (self.ekf_reference_lost or msg.header.frame_id != self.odom_frame
                    or msg.child_frame_id != self.body_frame or not self.fresh(stamp, now, .15)):
                return
            if self.ekf_odom is not None:
                previous = self.ekf_odom.header.stamp.to_sec()
                if stamp <= previous:
                    return
            p, q, v, w = msg.pose.pose.position, msg.pose.pose.orientation, msg.twist.twist.linear, msg.twist.twist.angular
            quaternion = np.array([q.x, q.y, q.z, q.w])
            if (not all(np.all(np.isfinite(value)) for value in
                        ((p.x, p.y, p.z), quaternion, (v.x, v.y, v.z), (w.x, w.y, w.z),
                         msg.pose.covariance, msg.twist.covariance))
                    or abs(np.linalg.norm(quaternion) - 1.) > .001):
                return
            # Tag geometry and ToF use FLU attitude; the ROS odometry body is RFU.
            quaternion = tf.transformations.quaternion_multiply(
                quaternion, tf.transformations.quaternion_from_euler(0, 0, math.pi / 2))
            omega = np.array([w.y, -w.x, w.z])
            self.attitude = (stamp, tf.transformations.euler_from_quaternion(quaternion), omega, quaternion)
            self.attitude_history.append(self.attitude)
            self.height.update_attitude(tuple(quaternion), stamp, monotonic())
            self.ekf_odom = msg
            self.ekf_history.append((stamp, np.array([p.x, p.y])))
            while self.ekf_history and stamp - self.ekf_history[0][0] > 2.:
                self.ekf_history.popleft()

    def local_odom(self):
        p = self.ekf_odom.pose.pose.position
        return np.array([p.x, p.y])

    def odom_at(self, stamp):
        history = self.ekf_history
        if not history or stamp < history[0][0] or stamp > history[-1][0]:
            return None
        if stamp == history[-1][0]:
            return history[-1][1]
        for (t0, p0), (t1, p1) in zip(history, list(history)[1:]):
            if t0 <= stamp <= t1:
                return p0 + (stamp - t0) / (t1 - t0) * (p1 - p0)

    def camera_callback(self, msg):
        with self.lock:
            # Ignore changing header timestamps. Geometry validates calibration on use.
            calibration = (msg.width, msg.height, msg.header.frame_id,
                           tuple(msg.K), tuple(msg.D), msg.distortion_model)
            if calibration != self.tag_camera:
                self.tag_samples.clear()
            self.tag_camera = calibration

    def tag_callback(self, msg):
        """Use tag 5's printed top as +Y in every flight mode; never command yaw."""
        with self.lock:
            now, stamp = rospy.get_time(), msg.header.stamp.to_sec()
            if msg.tag_id != 5:
                return
            if not self.fresh(stamp, now):
                self.tag_reason = 'Tag 5 frame is stale or invalid'
                return
            if self.tag_last_stamp is not None and stamp <= self.tag_last_stamp:
                return
            self.tag_last_stamp = stamp
            try:
                if self.tag_camera is None or not self.attitude_history or self.room.yaw_offset is None:
                    raise ValueError('Tag 5 needs camera calibration and initialized EKF heading')
                width, height, frame, k, d, model = self.tag_camera
                if (msg.image_width != width or msg.image_height != height
                        or not frame or msg.header.frame_id != frame):
                    raise ValueError('Tag 5 image does not match camera calibration')
                # Match image acquisition time, not delayed detector receipt time.
                attitude = min(self.attitude_history, key=lambda sample: abs(sample[0] - stamp))
                skew = abs(attitude[0] - stamp)
                if (not self.fresh(attitude[0], now) or skew > .05
                        or skew * np.linalg.norm(attitude[2]) > math.radians(1)):
                    raise ValueError('Tag 5 needs time-aligned EKF attitude')
                pixels = np.column_stack((msg.corner_x, msg.corner_y))
                if (pixels.shape != (4, 2) or np.any(pixels < 0)
                        or np.any(pixels[:, 0] >= width) or np.any(pixels[:, 1] >= height)):
                    raise ValueError('Invalid tag corners or image bounds')
                local_quaternion = tf.transformations.quaternion_multiply(
                    attitude[3], tf.transformations.quaternion_from_euler(0, 0, -math.pi / 2))
                offset = floor_tag_yaw_offset(pixels, k, d, local_quaternion, self.tag_rotation, model)
            except ValueError as error:
                self.tag_samples.clear()
                self.tag_reason = str(error)
                return
            if (self.tag_samples and (stamp - self.tag_samples[-1][0] > self.timeout
                    or any(abs(math.atan2(math.sin(offset - value), math.cos(offset - value)))
                           > math.radians(5) for _, value in self.tag_samples))):
                self.tag_samples.clear()
            self.tag_samples.append((stamp, offset))
            if len(self.tag_samples) < 3:
                self.tag_reason = 'Confirming tag 5 across three frames'
                return
            mean = math.atan2(sum(math.sin(v) for _, v in self.tag_samples),
                              sum(math.cos(v) for _, v in self.tag_samples))
            error = math.atan2(math.sin(mean - self.room.yaw_offset),
                               math.cos(mean - self.room.yaw_offset))
            # At most 2 degrees/sec, with no accumulated allowance through gaps
            # or bursts of delayed detections. Small errors converge smoothly.
            dt = min(.1, stamp - self.tag_samples[-2][0])
            if self.tag_correction_at is not None:
                dt = min(dt, max(0, now - self.tag_correction_at))
            limit = math.radians(2) * dt
            delta = max(-limit, min(limit, error * (1 - math.exp(-dt))))
            self.room.correct_yaw(delta, self.local_odom())
            self.tag_correction_at, self.tag_accepted_stamp = now, stamp
            self.tag_reason = 'Tag 5 correcting yaw'
            rospy.set_param('~room_yaw_offset', self.room.yaw_offset)

    def range_callback(self, msg):
        with self.lock:
            self.range_stamp = msg.header.stamp
            self.height.update_range(msg.range, msg.min_range, msg.max_range,
                                     msg.header.stamp.to_sec(), monotonic())

    def uwb_callback(self, msg):
        with self.lock:
            stamp = msg.header.stamp.to_sec()
            if msg.header.frame_id != self.frame or not self.fresh(stamp, rospy.get_time()):
                return
            p, c = msg.pose.pose.position, msg.pose.covariance
            self.pending.append((stamp, (p.x, p.y), [[c[0], c[1]], [c[6], c[7]]]))
            self.pending = sorted(self.pending, key=lambda item: item[0])[-20:]

    def anchors_callback(self, msg):
        with self.lock:
            stamp = msg.header.stamp.to_sec()
            positions = [(p.x, p.y, p.z) for p in msg.positions]
            valid = (msg.header.frame_id == self.frame and len(msg.anchor_ids) == len(positions) == 4
                     and len(set(msg.anchor_ids)) == 4 and all(msg.anchor_ids)
                     and np.all(np.isfinite(positions)) and self.fresh(stamp, rospy.get_time()))
            if valid:
                # All four surveyed anchors must form a nondegenerate convex outline.
                xy = np.asarray(positions)[:, :2]
                center = xy.mean(axis=0)
                order = np.argsort(np.arctan2(xy[:, 1] - center[1], xy[:, 0] - center[0]))
                hull = xy[order]
                edges = np.roll(hull, -1, axis=0) - hull
                turns = [edges[i, 0] * edges[(i + 1) % 4, 1] - edges[i, 1] * edges[(i + 1) % 4, 0] for i in range(4)]
                valid = all(t > 1e-6 for t in turns)
            if not valid:
                # Anchors are fixed geometry. Missing/partial reports do not move
                # the room; only a new valid layout can replace it.
                return
            if self.layout_stamp is not None and stamp <= self.layout_stamp:
                return
            layout = sorted(zip(msg.anchor_ids, positions))
            changed = self.layout is not None and (
                [a[0] for a in layout] != [a[0] for a in self.layout]
                or not np.allclose([a[1] for a in layout], [a[1] for a in self.layout], atol=0.02, rtol=0))
            if changed:
                self.invalidate_room()
            if self.layout is None or changed:
                self.layout = layout
            self.layout_stamp = stamp

    def step(self):
        with self.lock:
            now = rospy.get_time()
            if self.last_time is not None and now < self.last_time:
                self.ekf_reference_lost = True
                self.invalidate_room()
                self.height.range = self.height.attitude = self.attitude = None
                self.attitude_history.clear()
                self.tag_samples.clear()
                self.tag_last_stamp = self.tag_correction_at = self.tag_accepted_stamp = None
                self.layout = None
                self.layout_stamp = None
            self.last_time = now
            # Align once at startup. Tag 5 may subsequently correct this offset;
            # later turns/disarms must not recapture it from attitude alone.
            if (self.room.yaw_offset is None and self.mode == 'DISARMED'
                    and self.fresh(self.mode_at, now) and self.attitude is not None
                    and self.fresh(self.attitude[0], now) and not self.ekf_reference_lost):
                self.room.yaw_offset = math.pi / 2.0 - self.attitude[1][2]
                rospy.set_param('~room_yaw_offset', self.room.yaw_offset)
                rospy.loginfo('Startup heading aligned with map +Y; room_yaw_offset=%.9f rad',
                              self.room.yaw_offset)
            height, height_reason = self.height.height(monotonic(), now)
            attitude_ready = bool(self.attitude is not None and self.fresh(self.attitude[0], now, .15)
                                  and not self.ekf_reference_lost)
            local_ready = bool(attitude_ready and height is not None and self.ekf_ready
                               and self.fresh(self.ekf_ready_at, now, .15))
            self.local_reason = ('Clock changed; restart localization on the floor'
                                 if self.ekf_reference_lost else 'Waiting for EKF readiness')
            if not local_ready:
                # Odometry missed motion, so it can no longer carry the room pose.
                self.room.reset()
            pending = []
            if local_ready and self.layout is not None:
                for stamp, position, covariance in self.pending:
                    if self.fresh(stamp, now):
                        if stamp > self.ekf_history[-1][0]:
                            pending.append((stamp, position, covariance))
                            continue
                        _, self.reason = self.room.update(
                            position, covariance, stamp, self.odom_at(stamp))
            self.pending = pending
            # Only an accepted fix renews the room pose; rejected fixes still expire.
            if self.room.offset is not None and not self.room.ready(now):
                self.room.reset()
            room_ready = self.room.ready(now)
            ready = bool(local_ready and room_ready and self.layout is not None and height)
            predicting = ready and not self.fresh(self.room.stamp, now)
            reason = ('Predicting through UWB gap' if predicting
                      else 'OK' if ready else height_reason if height is None
                      else self.local_reason if self.ekf_reference_lost
                      else 'EKF attitude unavailable' if not attitude_ready
                      else self.local_reason if not local_ready
                      else 'Waiting for disarmed mode and fresh EKF attitude to align heading' if self.room.yaw_offset is None
                      else 'Four surveyed anchors required' if self.layout is None
                      else 'UWB missing or stale' if self.reason == 'OK' else self.reason)
            self.local_pub.publish(Bool(data=local_ready))
            self.ready_pub.publish(Bool(data=ready))
            self.generation_pub.publish(UInt32(data=self.generation))
            if height and attitude_ready:
                self.publish_estimates(local_ready, ready, now)
            status = DiagnosticStatus()
            status.name, status.hardware_id = 'fusion_localization', 'uwb+imu+tof+camera'
            status.level = DiagnosticStatus.OK if ready and not predicting else DiagnosticStatus.WARN
            status.message = reason
            status.values = [KeyValue(key='velocity_source', value='EKF'),
                             KeyValue(key='local_ready', value=str(local_ready)),
                             KeyValue(key='last_velocity_result', value=self.local_reason),
                             KeyValue(key='acceleration_bias', value='EKF internal'),
                             KeyValue(key='room_yaw_offset', value=str(self.room.yaw_offset)),
                             KeyValue(key='tag_yaw_status', value=(self.tag_reason
                                 if self.fresh(self.tag_last_stamp, now) else 'Tag 5 unavailable; retaining yaw offset')),
                             KeyValue(key='tag_yaw_stamp', value=str(self.tag_accepted_stamp)),
                             KeyValue(key='height_source', value='EKF + ToF'),
                             KeyValue(key='frame_id', value=self.frame),
                             KeyValue(key='last_uwb_result', value=self.reason)]
            diagnostics = DiagnosticArray()
            diagnostics.header.stamp = rospy.Time.from_sec(now)
            diagnostics.status = [status]
            self.status_pub.publish(diagnostics)

    def publish_estimates(self, local_ready, ready, now):
        odometry = self.ekf_odom
        stamp = odometry.header.stamp.to_sec()
        if stamp == self.ekf_published_stamp:
            return
        state = State()
        state.header = deepcopy(odometry.header)
        # Keep the existing altitude watchdog tied to a real ToF observation.
        state.header.stamp = min((odometry.header.stamp, self.range_stamp), key=lambda value: value.to_sec())
        state.pose_with_covariance = deepcopy(odometry.pose)
        state.twist_with_covariance = deepcopy(odometry.twist)
        q = odometry.pose.pose.orientation
        quaternion = (q.x, q.y, q.z, q.w)
        yaw = tf.transformations.euler_from_quaternion(quaternion)[2]
        c, s = math.cos(yaw), math.sin(yaw)
        level = np.array([[c, s, 0.], [-s, c, 0.], [0., 0., 1.]])
        rotation = level.dot(quaternion_matrix(quaternion))
        v = odometry.twist.twist.linear
        velocity = rotation.dot([v.x, v.y, v.z])
        state.twist_with_covariance.twist.linear.x = velocity[0]
        state.twist_with_covariance.twist.linear.y = velocity[1]
        state.twist_with_covariance.twist.linear.z = velocity[2]
        # State uses heading-level translation; Odometry retains physical body twist.
        transform = np.eye(6)
        transform[:3, :3] = rotation
        covariance = np.asarray(odometry.twist.covariance).reshape(6, 6)
        state.twist_with_covariance.covariance = transform.dot(covariance).dot(transform.T).ravel().tolist()
        self.state_pub.publish(state)
        self.ekf_published_stamp = stamp
        if not local_ready:
            return
        self.odom_pub.publish(odometry)
        p = odometry.pose.pose.position
        self.broadcaster.sendTransform((p.x, p.y, p.z), quaternion, odometry.header.stamp,
                                       self.body_frame, self.odom_frame)
        self.publish_room(odometry, p.z + self.height.floor_z, ready, now)

    def publish_room(self, odometry, height, ready, now):
        if not ready:
            return
        q = odometry.pose.pose.orientation
        quaternion = (q.x, q.y, q.z, q.w)
        pose = PoseWithCovarianceStamped()
        pose.header.frame_id = self.frame
        # Odometry carries the pose, but must not make an old fix look newly measured.
        pose.header.stamp = rospy.Time.from_sec(min(odometry.header.stamp.to_sec(), self.room.stamp))
        p = pose.pose.pose.position
        p.x, p.y = self.room.position(self.local_odom())
        p.z = height
        q = pose.pose.pose.orientation
        q.x, q.y, q.z, q.w = tf.transformations.quaternion_multiply(
            tf.transformations.quaternion_from_euler(0, 0, self.room.yaw_offset), quaternion)
        covariance = self.room.covariance(now)
        pose.pose.covariance[0], pose.pose.covariance[1] = covariance[0]
        pose.pose.covariance[6], pose.pose.covariance[7] = covariance[1]
        pose.pose.covariance[14] = 0.03 ** 2
        for index in (21, 28, 35):
            pose.pose.covariance[index] = 0.15 ** 2
        local_covariance = np.asarray(odometry.pose.covariance).reshape(6, 6)
        covariance = np.asarray(pose.pose.covariance).reshape(6, 6)
        rotation = quaternion_matrix(tf.transformations.quaternion_from_euler(0, 0, self.room.yaw_offset))
        covariance[3:, 3:] = rotation.dot(local_covariance[3:, 3:]).dot(rotation.T)
        covariance[2, 2] = local_covariance[2, 2]
        pose.pose.covariance = covariance.ravel().tolist()
        self.pose_pub.publish(pose)
        self.broadcaster.sendTransform((self.room.offset[0], self.room.offset[1], self.height.floor_z),
            tf.transformations.quaternion_from_euler(0, 0, self.room.yaw_offset),
            pose.header.stamp, self.odom_frame, self.frame)


def main():
    rospy.init_node('fusion_localization')
    node = FusionLocalizationNode()
    rate = rospy.Rate(60)
    while not rospy.is_shutdown():
        node.step()
        rate.sleep()


if __name__ == '__main__':
    main()
