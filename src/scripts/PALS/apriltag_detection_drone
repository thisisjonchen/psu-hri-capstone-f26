#!/usr/bin/env python
"""Detect AprilTags onboard from ROS camera images; publish results to rosbridge."""
from __future__ import print_function

import threading
import time

import cv2
import numpy as np
import rospy
from sensor_msgs.msg import CompressedImage
from pidrone_pkg.msg import TagCorners, TagDetection

TAG_ZONES = {0: 'PICKUP', 1: 'DROP_OFF', 2: 'BORDER'}


def make_detector():
    # ROS Kinetic uses Python 2; newer drone environments can use AprilTag 3.
    try:
        from pupil_apriltags import Detector
    except ImportError:
        import apriltag
        return (apriltag.Detector(apriltag.DetectorOptions(
            families='tag36h11', nthreads=1, quad_decimate=1.0)), (0, 1, 2, 3))
    # AprilTag 3 returns BL, BR, TR, TL; AprilTag 2 returns TL, TR, BR, BL.
    return Detector(families='tag36h11', nthreads=1, quad_decimate=1.0), (3, 2, 1, 0)


class AprilTagNode(object):
    def __init__(self):
        self.detector, self.corner_order = make_detector()
        self.rate = float(rospy.get_param('~rate', 10))
        self.timeout = float(rospy.get_param('~camera_timeout', 0.5))
        if not 0 < self.rate <= 30 or self.timeout <= 0:
            raise ValueError('rate must be between 0 and 30 Hz; camera_timeout must be positive')
        self.lock = threading.Lock()
        self.pending = None
        self.last_frame_at = None
        self.result = TagDetection()
        self.result.camera_online = False
        self.publisher = rospy.Publisher('/pidrone/apriltag/detections', TagDetection, queue_size=1)
        self.corner_publisher = rospy.Publisher('/pidrone/apriltag/reference_corners', TagCorners, queue_size=1)
        topic = rospy.get_param('~image_topic', '/raspicam_node/image/compressed')
        self.subscriber = rospy.Subscriber(topic, CompressedImage, self.image_callback,
                                           queue_size=1, buff_size=2 ** 20)
        rospy.loginfo('AprilTag detection: %s -> /pidrone/apriltag/detections at %.1f Hz', topic, self.rate)

    def image_callback(self, message):
        # Keep only the newest frame. Detection runs in the rate-limited main loop.
        with self.lock:
            self.pending = (message, time.time())

    def step(self):
        with self.lock:
            pending, self.pending = self.pending, None
        if pending is not None:
            message, received = pending
            self.result = TagDetection()
            self.result.header = message.header
            self.last_frame_at = None
            try:
                age = rospy.Time.now().to_sec() - message.header.stamp.to_sec()
                if time.time() - received <= self.timeout and (message.header.stamp.to_sec() <= 0 or age <= self.timeout):
                    image = cv2.imdecode(np.frombuffer(message.data, dtype=np.uint8), cv2.IMREAD_GRAYSCALE)
                    if image is None:
                        raise ValueError('Invalid compressed camera frame')
                    detections = self.detector.detect(image)
                    # Stable order; unknown IDs are still reported to consumers.
                    ids = sorted(set(int(tag.tag_id) for tag in detections))
                    self.result.tag_ids = ids
                    self.result.zones = [TAG_ZONES.get(tag_id, 'UNKNOWN') for tag_id in ids]
                    centers = {int(tag.tag_id): tag.center for tag in detections}
                    self.result.center_x = [float(centers[tag_id][0]) for tag_id in ids]
                    self.result.center_y = [float(centers[tag_id][1]) for tag_id in ids]
                    self.result.image_height, self.result.image_width = image.shape
                    self.result.camera_online = True
                    self.last_frame_at = received
                    # Only an unambiguous, uncorrected decode of our fixed yaw
                    # reference may affect fusion. Keep the existing detections contract.
                    references = [tag for tag in detections if int(tag.tag_id) == 5]
                    if (len(references) == 1 and references[0].hamming == 0
                            and references[0].decision_margin >= 30
                            and message.header.stamp.to_sec() > 0 and 0 <= age <= self.timeout):
                        corners = np.asarray(references[0].corners)[list(self.corner_order)]
                        reference = TagCorners()
                        reference.header = message.header
                        reference.tag_id = 5
                        reference.image_height, reference.image_width = image.shape
                        reference.corner_x = [float(p[0]) for p in corners]
                        reference.corner_y = [float(p[1]) for p in corners]
                        self.corner_publisher.publish(reference)
            except (ValueError, cv2.error, RuntimeError) as error:
                rospy.logwarn_throttle(5, 'AprilTag image processing failed: {}'.format(error))
        if self.last_frame_at is None or time.time() - self.last_frame_at > self.timeout:
            self.result = TagDetection()
            self.result.header.stamp = rospy.Time.now()
            self.result.camera_online = False
        self.publisher.publish(self.result)

    def run(self):
        rate = rospy.Rate(self.rate)
        while not rospy.is_shutdown():
            self.step()
            rate.sleep()


def main():
    rospy.init_node('apriltag_detection')
    try:
        AprilTagNode().run()
    except rospy.ROSInterruptException:
        pass


if __name__ == '__main__':
    main()
