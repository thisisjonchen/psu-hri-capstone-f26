<launch>
  <!-- Use the root namespace on each drone's separate ROS master. -->
  <arg name="namespace" default="/"/>
  <arg name="port" default="/dev/ttyACM1"/>
  <arg name="frame_id" default="map"/>
  <arg name="range_topic" default="pidrone/range"/>
  <arg name="imu_topic" default="pidrone/imu"/>
  <arg name="compensate_tilt" default="true"/>
  <arg name="floor_z" default="0.0"/>
  <arg name="tof_offset_z" default="0.0"/>
  <group ns="$(arg namespace)">
    <node pkg="pidrone_pkg" type="uwb_localization_node" name="uwb_localization" output="screen">
      <rosparam command="load" file="$(find pidrone_pkg)/params/uwb_localization.yaml"/>
      <param name="port" value="$(arg port)" type="str"/>
      <param name="frame_id" value="$(arg frame_id)"/>
      <param name="range_topic" value="$(arg range_topic)"/>
      <param name="imu_topic" value="$(arg imu_topic)"/>
      <param name="compensate_tilt" value="$(arg compensate_tilt)"/>
      <param name="floor_z" value="$(arg floor_z)"/>
      <param name="tof_offset_z" value="$(arg tof_offset_z)"/>
    </node>
  </group>
</launch>
