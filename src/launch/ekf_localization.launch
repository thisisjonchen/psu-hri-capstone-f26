<launch>
  <!-- Start disarmed, resting on the floor facing map +Y until it has 20 UWB fixes (at least four seconds). -->
  <arg name="calibration" default="$(find pidrone_pkg)/params/ekf.yaml"/>
  <arg name="body_frame" default="pidrone_body"/>
  <arg name="frame_id" default="map"/>
  <node pkg="pidrone_pkg" type="ekf_localization_node" name="ekf_localization" output="screen" required="true">
    <rosparam command="load" file="$(arg calibration)" ns="calibration"/>
    <param name="body_frame" value="$(arg body_frame)"/>
    <param name="frame_id" value="$(arg frame_id)"/>
  </node>
</launch>
