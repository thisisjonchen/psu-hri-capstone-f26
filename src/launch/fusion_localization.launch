<launch>
  <arg name="namespace" default="/"/>
  <arg name="frame_id" default="map"/>
  <arg name="floor_z" default="0.0"/>
  <arg name="body_frame" default="pidrone_body"/>
  <arg name="ekf_calibration" default="$(find pidrone_pkg)/params/ekf.yaml"/>
  <group ns="$(arg namespace)">
    <node pkg="pidrone_pkg" type="fusion_localization_node" name="fusion_localization" output="screen"
          required="true">
      <rosparam command="load" file="$(find pidrone_pkg)/params/fusion_localization.yaml"/>
      <param name="frame_id" value="$(arg frame_id)"/>
      <param name="floor_z" value="$(arg floor_z)"/>
      <param name="body_frame" value="$(arg body_frame)"/>
    </node>
    <node pkg="pidrone_pkg" type="ekf_localization_node" name="ekf_localization" output="screen"
          required="true">
      <rosparam command="load" file="$(arg ekf_calibration)" ns="calibration"/>
      <param name="frame_id" value="$(arg frame_id)"/>
      <param name="body_frame" value="$(arg body_frame)"/>
    </node>
  </group>
</launch>
