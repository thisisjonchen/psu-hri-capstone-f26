<launch>
  <node pkg="raspicam_node" type="raspicam_node" name="cam" output="screen">
    <rosparam command="load" file="$(find pidrone_pkg)/params/cam.yaml"/>
    <remap from="~image" to="/raspicam_node/image_raw"/>
    <remap from="~image/compressed" to="/raspicam_node/image/compressed"/>
    <remap from="~camera_info" to="/raspicam_node/camera_info"/>
    <remap from="~motion_vectors" to="/raspicam_node/motion_vectors"/>
    <remap from="~set_camera_info" to="/raspicam_node/set_camera_info"/>
  </node>
</launch>
