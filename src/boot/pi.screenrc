# Derived from the Paradox pair programming screenrc, UChicago 2010.
shell /bin/bash
startup_message off

defscrollback 5000

escape ``

hardstatus             alwayslastline
hardstatus string '%{= kG}[ %{G}%H %{g}][%= %{= kw}%?%-Lw%?%{r}(%{W}%n*%f%t%?(%u)%?%{r})%{w}%?%+Lw%?%?%= %{g}][%{B} %d/%m %{W}%c %{g}]'

multiuser on

# Load the ROS environment and keep each window open when its node exits.
screen -t "rcore" /bin/bash -ic 'source boot/screen_node.sh core; exec /bin/bash --norc -i'
screen -t "FC" /bin/bash -ic 'source boot/screen_node.sh fc; exec /bin/bash --norc -i'
screen -t "PID" /bin/bash -ic 'source boot/screen_node.sh pid; exec /bin/bash --norc -i'
screen -t "SE" /bin/bash -ic 'source boot/screen_node.sh se; exec /bin/bash --norc -i'
screen -t "Vision" /bin/bash -ic 'source boot/screen_node.sh vision; exec /bin/bash --norc -i'
screen -t "TOF" /bin/bash -ic 'source boot/screen_node.sh tof; exec /bin/bash --norc -i'
screen -t "rosbridge" /bin/bash -ic 'source boot/screen_node.sh bridge; exec /bin/bash --norc -i'
screen -t "web_vid_serv" /bin/bash -ic 'source boot/screen_node.sh video; exec /bin/bash --norc -i'
screen -t "AprilTags" /bin/bash -ic 'source boot/screen_node.sh tags; exec /bin/bash --norc -i'
screen -t "UWB" /bin/bash -ic 'source boot/screen_node.sh uwb; exec /bin/bash --norc -i'
screen -t "routine" /bin/bash -ic 'source boot/screen_node.sh check; exec /bin/bash --norc -i'
screen -t "free1" /bin/bash -ic 'source boot/screen_node.sh shell; exec /bin/bash --norc -i'
screen -t "TagMap" /bin/bash -ic 'source boot/screen_node.sh tagmap; exec /bin/bash --norc -i'
screen -t "free2" /bin/bash -ic 'source boot/screen_node.sh shell; exec /bin/bash --norc -i'
